<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/decision_buttons_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="parent">

        <Button
            android:id="@+id/btn_scheduled_visits"
            android:layout_width="500dp"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_marginTop="70dp"
            android:layout_marginBottom="70dp"
            android:layout_weight="1"
            android:backgroundTint="@color/colorPrimary"
            android:paddingLeft="2dp"
            android:paddingTop="2dp"
            android:paddingRight="2dp"
            android:paddingBottom="2dp"
            android:text="@string/visits_overview_scheduled_visits_title"
            android:textAppearance="@style/ButtonTextStyling"
            android:textColor="@color/colorTextOnSecondary"
            android:textSize="34sp"
            android:textStyle="bold"
            app:cornerRadius="30dp" />

        <Button
            android:id="@+id/btn_historical_visits"
            android:layout_width="500dp"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_marginTop="70dp"
            android:layout_marginBottom="70dp"
            android:layout_weight="1"
            android:backgroundTint="@color/colorTextOnLight"
            android:paddingLeft="2dp"
            android:paddingTop="2dp"
            android:paddingRight="2dp"
            android:paddingBottom="2dp"
            android:text="@string/visits_overview_historical_visits_title"
            android:textAppearance="@style/ButtonTextStyling"
            android:textColor="@color/colorTextOnSecondary"
            android:textSize="34sp"
            android:textStyle="bold"
            app:cornerRadius="30dp" />

        <Button
            android:id="@+id/btn_missed_visits"
            android:layout_width="500dp"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_marginTop="70dp"
            android:layout_marginBottom="70dp"
            android:layout_weight="1"
            android:backgroundTint="@color/errorLight"
            android:paddingLeft="2dp"
            android:paddingTop="2dp"
            android:paddingRight="2dp"
            android:paddingBottom="2dp"
            android:text="@string/visits_overview_missed_visits_title"
            android:textAppearance="@style/ButtonTextStyling"
            android:textColor="@color/colorTextOnSecondary"
            android:textSize="34sp"
            android:textStyle="bold"
            app:cornerRadius="30dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>