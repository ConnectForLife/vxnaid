<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/padding_8_16"
    android:paddingEnd="@dimen/padding_8_16"
    android:paddingTop="@dimen/margin_4_8"
    android:paddingBottom="@dimen/margin_4_8">

    <TextView
        android:id="@+id/tv_service_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="@dimen/chp_text_list_item"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:id="@+id/tv_service_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_8_16"
        android:textSize="@dimen/chp_text_list_item"
        android:textColor="?android:attr/textColorPrimary" />

</LinearLayout>
