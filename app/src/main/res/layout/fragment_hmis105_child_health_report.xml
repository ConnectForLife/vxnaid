<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/padding_8"
        android:paddingVertical="@dimen/padding_4">

        <!-- Date Filter Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_4_8"
            android:orientation="vertical"
            android:paddingVertical="@dimen/padding_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/margin_4">

                <Button
                    android:id="@+id/btn_start_date"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="@dimen/padding_4"
                    android:text="@string/visits_overview_start_date_label"
                    android:textSize="@dimen/text_size_11_14" />

                <TextView
                    android:id="@+id/label_start_date"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_4"
                    android:text="@string/visits_overview_not_set_label"
                    android:textSize="@dimen/text_16"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_end_date"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="@dimen/padding_4"
                    android:text="@string/visits_overview_end_date_label"
                    android:textSize="@dimen/text_size_11_14" />

                <TextView
                    android:id="@+id/label_end_date"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_4"
                    android:text="@string/not_set"
                    android:textSize="@dimen/text_16"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Table with horizontal scroll -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Header Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/colorPrimary">

                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="@string/chp_col_dose"
                        android:padding="@dimen/padding_4_8"
                        android:textColor="@color/colorTextOnSecondary"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textSize="@dimen/text_12" />

                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="@string/chp_col_location"
                        android:padding="@dimen/padding_4_8"
                        android:textColor="@color/colorTextOnSecondary"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textSize="@dimen/text_12" />

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:text="@string/chp_col_6_11_m"
                        android:padding="@dimen/padding_4_8"
                        android:textColor="@color/colorTextOnSecondary"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textSize="@dimen/text_12" />

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:text="@string/chp_col_6_11_f"
                        android:padding="@dimen/padding_4_8"
                        android:textColor="@color/colorTextOnSecondary"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textSize="@dimen/text_12" />

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:text="@string/chp_col_12_59_m"
                        android:padding="@dimen/padding_4_8"
                        android:textColor="@color/colorTextOnSecondary"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textSize="@dimen/text_12" />

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:text="@string/chp_col_12_59_f"
                        android:padding="@dimen/padding_4_8"
                        android:textColor="@color/colorTextOnSecondary"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textSize="@dimen/text_12" />

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:text="@string/chp_col_5_14_m"
                        android:padding="@dimen/padding_4_8"
                        android:textColor="@color/colorTextOnSecondary"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textSize="@dimen/text_12" />

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:text="@string/chp_col_5_14_f"
                        android:padding="@dimen/padding_4_8"
                        android:textColor="@color/colorTextOnSecondary"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textSize="@dimen/text_12" />

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:text="@string/chp_col_total"
                        android:padding="@dimen/padding_4_8"
                        android:textColor="@color/colorTextOnSecondary"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textSize="@dimen/text_12" />

                </LinearLayout>

                <!-- Data Rows -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view_report"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Export Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/margin_4_8">

            <Button
                android:id="@+id/btn_export_excel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="@dimen/btn_padding_4_8"
                android:text="@string/visits_overview_download_excel_button_label"
                android:textSize="@dimen/text_size_11_14" />

        </LinearLayout>

    </LinearLayout>

</layout>
