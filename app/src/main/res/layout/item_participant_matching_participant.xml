<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.jnj.vaccinetracker.participantflow.screens.ParticipantFlowMatchingViewModel.ParticipantItem" />

        <variable
            name="selected"
            type="boolean" />

        <import type="android.view.View" />

    </data>

    <LinearLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/participant_item_bg"
        android:orientation="vertical"
        app:selected="@{selected}"
        android:padding="@dimen/padding_8_16">

        <TextView
            android:id="@+id/textView_childNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text='@{"Child Number:      " + (item.participant.childNumber != null ? item.participant.childNumber : "")}'
            android:textSize="@dimen/text_size_14_18"
            tools:text="98574328" />

        <TextView
            android:id="@+id/textView_phoneNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text='@{"Mobile Phone:      " + (item.participant.telephone != null ? item.participant.telephone : "")}'
            android:textSize="@dimen/text_size_14_18"
            tools:text="777123456" />

        <TextView
            android:id="@+id/motherName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text='@{"Mother Name:      " + (item.participant.motherFirstName != null ? item.participant.motherFirstName : "") + " " + (item.participant.motherLastName != null ? item.participant.motherLastName : "")}'
            android:textSize="@dimen/text_size_14_18"
            tools:text="Mother Name" />

        <TextView
            android:id="@+id/textView_yearOfBirth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text='@{item.participant.isBirthDateEstimated ? "Date of Birth:      ~" + item.participant.birthDateText : "Date of Birth:        " + item.participant.birthDateText}'
            android:textSize="@dimen/text_size_14_18"
            tools:text="1992" />

        <TextView
            android:id="@+id/textView_homeLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text='@{"Address:                " + item.participant.homeLocation}'
            android:textSize="@dimen/text_size_14_18"
            tools:text="Belgium, Street 1" />

        <TextView
            android:id="@+id/textView_vaccine"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@{item.participant.vaccine.display}"
            android:textSize="@dimen/text_size_14_18"
            tools:text="Vaccine" />



        <Button
            android:id="@+id/border"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:background="@color/colorPrimaryLight"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView_vaccine" />
    </LinearLayout>
</layout>
