<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="nextVisit"
            type="com.jnj.vaccinetracker.sync.domain.entities.UpcomingVisit" />
        <import type="android.view.View" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/img_header"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:background="@color/alertLight"
                android:gravity="center"
                android:paddingVertical="30dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_checkmark_alert"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/colorTextOnPrimary"
                tools:ignore="ContentDescription"/>

            <TextView
                android:id="@+id/label_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_8"
                android:gravity="center_horizontal"
                android:text="@string/schedule_reason_label"
                android:textAppearance="@style/PopupTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/img_header" />

            <LinearLayout
                android:id="@+id/upcoming_visit_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_margin="@dimen/margin_4"
                android:paddingTop="@dimen/padding_4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/label_title">

                <EditText
                    android:id="@+id/editText_reschedule_reason"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:padding="16dp"
                    android:hint="@string/reschedule_hint"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/margin_4"
                android:background="#CCCCCC"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/upcoming_visit_container" />

            <TextView
                android:id="@+id/schedule_next_visit_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_8"
                android:gravity="center_horizontal"
                android:text="@string/visit_reschedule_visit_title"
                android:textAppearance="@style/PopupTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/upcoming_visit_container" />

            <LinearLayout
                android:id="@+id/next_visit_date_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_8"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/schedule_next_visit_title">


                <TextView
                    android:id="@+id/next_visit_date_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/visit_schedule_next_visit_set_next_visit_title"
                    android:textAppearance="@style/LabelText" />

                <TextView
                    android:id="@+id/next_visit_date_value"
                    android:layout_weight="1"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_marginVertical="@dimen/margin_8"
                    android:hint="@string/hint_new_visit_date"
                    android:textSize="@dimen/btn_text_size_18_32"/>

                <Button
                    android:id="@+id/next_visit_date_picker_button"
                    style="@style/Widget.AppCompat.Button.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/colorPrimary"
                    android:text="@string/participant_registration_details_action_set_Next_visit_date"
                    android:textAppearance="@style/ButtonTextStyling" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_finish"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:backgroundTint="@color/colorPrimary"
                android:text="@string/general_label_close"
                android:textAppearance="@style/ButtonTextStyling"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_save_visit"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/next_visit_date_container"
                app:layout_constraintHorizontal_weight="1" />

            <Button
                android:id="@+id/btn_save_visit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:backgroundTint="@color/colorPrimary"
                android:text="@string/reschedule_visit_button_label_mobile"
                android:textAppearance="@style/ButtonTextStyling"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/btn_finish"
                app:layout_constraintTop_toBottomOf="@id/next_visit_date_container"
                app:layout_constraintHorizontal_weight="1" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</layout>