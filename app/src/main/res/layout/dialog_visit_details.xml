<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="visitDetails"
            type="com.jnj.vaccinetracker.visitsoverview.dto.VisitDetailsDTO" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/padding_16_24"
        android:paddingVertical="@dimen/padding_16_24"
        android:background="@android:color/white"
        android:minHeight="250dp"
        android:minWidth="300dp">

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="1">

            <TableRow
                android:id="@+id/tableRow_visitDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/margin_4_8">

                <TextView
                    android:id="@+id/label_visit_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="@string/visits_overview_details_visit_date_label"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_16_20"/>
                <TextView
                    android:id="@+id/value_visit_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="@{visitDetails.formattedVisitDate}"
                    android:textSize="@dimen/text_size_16_20"/>
            </TableRow>

            <TableRow
                android:id="@+id/tableRow_vaccines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_4_8">

                <TextView
                    android:id="@+id/label_vaccines"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="@string/visits_overview_details_visit_schedule_label"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_16_20"/>
                <TextView
                    android:id="@+id/value_vaccines"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="@{visitDetails.visitType}"
                    android:textSize="@dimen/text_size_16_20"/>
            </TableRow>

            <TableRow
                android:id="@+id/tableRow_phoneNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_4_8">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="@string/visits_overview_details_phone_number_label"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_16_20"/>
                <TextView
                    android:id="@+id/value_phone_number"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="@{visitDetails.phoneNumber}"
                    android:textSize="@dimen/text_size_16_20"/>
            </TableRow>

            <TableRow
                android:id="@+id/tableRow_clientId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_4_8">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="@string/visits_overview_details_client_id_label"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_16_20"/>
                <TextView
                    android:id="@+id/value_client_id"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="@{visitDetails.clientID}"
                    android:textSize="@dimen/text_size_16_20"/>
            </TableRow>

            <TableRow
                android:id="@+id/tableRow_clientName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_4_8">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="@string/visits_overview_details_client_name_label"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_16_20"/>
                <TextView
                    android:id="@+id/value_client_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="@{visitDetails.clientFullName}"
                    android:textSize="@dimen/text_size_16_20"/>
            </TableRow>

            <TableRow
                android:id="@+id/tableRow_clientMotherFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_4_8">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="@string/visits_overview_client_mothers_name_column_label"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_size_16_20"/>
                <TextView
                    android:id="@+id/value_client_mother_Name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="@{visitDetails.clientMotherName}"
                    android:textSize="@dimen/text_size_16_20"/>
            </TableRow>

        </TableLayout>

        <Button
            android:id="@+id/close_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_8_16"
            android:text="@string/visits_overview_details_close_button_label" />
    </LinearLayout>
</layout>
