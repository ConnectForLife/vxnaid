<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_margin="@dimen/margin_32_64">

            <TextView
                android:id="@+id/textView_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="32dp"
                android:layout_marginBottom="@dimen/margin_32_64"
                android:text="@string/contraindications_description"
                android:textSize="@dimen/contraindications_text_size"
                android:textAlignment="center"
                android:textAppearance="@style/ScreenTitle" />

            <LinearLayout
                android:id="@+id/button_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/textView_intro">

                <Button
                    android:id="@+id/btn_yes"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/padding_16_32"
                    android:layout_marginEnd="@dimen/margin_8_16"
                    android:paddingVertical="@dimen/padding_4_8"
                    android:textSize="@dimen/btn_text_size_18_32"
                    android:text="@string/general_label_yes" />

                <Button
                    android:id="@+id/btn_no"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/padding_16_32"
                    android:paddingVertical="@dimen/padding_4_8"
                    android:textSize="@dimen/btn_text_size_18_32"
                    android:text="@string/general_label_no"/>
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
