<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="viewModel"
            type="com.jnj.vaccinetracker.register.screens.RegisterParticipantHistoricalDataViewModel" />

        <variable
            name="flowViewModel"
            type="com.jnj.vaccinetracker.register.RegisterParticipantFlowViewModel" />

        <import type="com.jnj.vaccinetracker.common.domain.entities.Gender" />

        <import type="android.view.View" />

        <import type="android.text.InputType" />

    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ProgressBar
            android:id="@+id/loading_indicator"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:indeterminate="true"
            android:visibility="@{viewModel.loading ? View.VISIBLE : View.GONE}" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/margin_16"
                android:padding="@dimen/btn_padding_8_16"
                android:text="@string/participant_registration_historic_visits_title"
                android:textAlignment="center"
                android:textAppearance="@style/ScreenTitle"
                android:textSize="@dimen/page_title_18_32"
                android:visibility="@{viewModel.isEdit ? View.INVISIBLE : View.VISIBLE}" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_gravity="center"
                android:layout_weight="1">

                <GridLayout
                    android:id="@+id/button_grid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:columnCount="2"
                    android:padding="@dimen/padding_8_16"
                    android:rowCount="2"></GridLayout>

            </ScrollView>

            <Button
                android:id="@+id/btn_submit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="@dimen/margin_8_16"
                android:backgroundTint="@color/colorPrimary"
                android:paddingHorizontal="@dimen/btn_padding_8_16"
                android:paddingVertical="@dimen/padding_4_8"
                android:text="@string/participant_administered_vaccines_action_save"
                android:textAppearance="@style/ButtonTextStyling"
                android:textSize="@dimen/text_size_12_16"
                android:visibility="@{viewModel.isEdit ? View.INVISIBLE : View.VISIBLE}" />
        </LinearLayout>

    </FrameLayout>
</layout>
