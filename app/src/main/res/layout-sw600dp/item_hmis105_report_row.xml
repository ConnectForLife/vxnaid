<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/row_even_background">

        <TextView
            android:id="@+id/text_view_doses"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_8_16"
            android:textSize="@dimen/text_12"
            android:gravity="center" />

        <TextView
            android:id="@+id/text_view_under1_static"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_8_16"
            android:textSize="@dimen/text_12"
            android:gravity="center" />

        <TextView
            android:id="@+id/text_view_under1_outreach"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_8_16"
            android:textSize="@dimen/text_12"
            android:gravity="center" />

        <TextView
            android:id="@+id/text_view_1to4_static"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_8_16"
            android:textSize="@dimen/text_12"
            android:gravity="center" />

        <TextView
            android:id="@+id/text_view_1to4_outreach"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_8_16"
            android:textSize="@dimen/text_12"
            android:gravity="center" />

        <TextView
            android:id="@+id/text_view_5to14_static"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_8_16"
            android:textSize="@dimen/text_12"
            android:gravity="center" />

        <TextView
            android:id="@+id/text_view_5to14_outreach"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_8_16"
            android:textSize="@dimen/text_12"
            android:gravity="center" />

        <TextView
            android:id="@+id/text_view_total"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_8_16"
            android:textSize="@dimen/text_12"
            android:textStyle="bold"
            android:gravity="center" />

    </LinearLayout>

</layout>

