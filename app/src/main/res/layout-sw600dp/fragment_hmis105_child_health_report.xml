<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/padding_16"
        android:paddingVertical="@dimen/padding_8">

        <!-- Date Filter Section — side by side on tablet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_8_16"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/padding_4_8">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginEnd="@dimen/margin_4_8">

                <Button
                    android:id="@+id/btn_start_date"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="@dimen/padding_4"
                    android:text="@string/visits_overview_start_date_label"
                    android:textSize="@dimen/text_size_12_16" />

                <TextView
                    android:id="@+id/label_start_date"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_4_8"
                    android:text="@string/visits_overview_not_set_label"
                    android:textSize="@dimen/text_size_14_18"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginStart="@dimen/margin_4_8">

                <Button
                    android:id="@+id/btn_end_date"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="@dimen/padding_4"
                    android:text="@string/visits_overview_end_date_label"
                    android:textSize="@dimen/text_size_12_16" />

                <TextView
                    android:id="@+id/label_end_date"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_4_8"
                    android:text="@string/not_set"
                    android:textSize="@dimen/text_size_14_18"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Table — no HorizontalScrollView on tablet, columns fill width -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/colorPrimary">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="2"
                    android:layout_height="wrap_content"
                    android:text="@string/chp_col_dose"
                    android:padding="@dimen/padding_4_8"
                    android:textColor="@color/colorTextOnSecondary"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textSize="@dimen/text_14" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1.5"
                    android:layout_height="wrap_content"
                    android:text="@string/chp_col_location"
                    android:padding="@dimen/padding_4_8"
                    android:textColor="@color/colorTextOnSecondary"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textSize="@dimen/text_14" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/chp_col_6_11_m"
                    android:padding="@dimen/padding_4_8"
                    android:textColor="@color/colorTextOnSecondary"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textSize="@dimen/text_14" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/chp_col_6_11_f"
                    android:padding="@dimen/padding_4_8"
                    android:textColor="@color/colorTextOnSecondary"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textSize="@dimen/text_14" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/chp_col_12_59_m"
                    android:padding="@dimen/padding_4_8"
                    android:textColor="@color/colorTextOnSecondary"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textSize="@dimen/text_14" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/chp_col_12_59_f"
                    android:padding="@dimen/padding_4_8"
                    android:textColor="@color/colorTextOnSecondary"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textSize="@dimen/text_14" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/chp_col_5_14_m"
                    android:padding="@dimen/padding_4_8"
                    android:textColor="@color/colorTextOnSecondary"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textSize="@dimen/text_14" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/chp_col_5_14_f"
                    android:padding="@dimen/padding_4_8"
                    android:textColor="@color/colorTextOnSecondary"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textSize="@dimen/text_14" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/chp_col_total"
                    android:padding="@dimen/padding_4_8"
                    android:textColor="@color/colorTextOnSecondary"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textSize="@dimen/text_14" />

            </LinearLayout>

            <!-- Data Rows -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view_report"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>

        <!-- Export Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/margin_8_16">

            <Button
                android:id="@+id/btn_export_excel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="@dimen/btn_padding_4_8"
                android:text="@string/visits_overview_download_excel_button_label"
                android:textSize="@dimen/text_size_12_16" />

        </LinearLayout>

    </LinearLayout>

</layout>
